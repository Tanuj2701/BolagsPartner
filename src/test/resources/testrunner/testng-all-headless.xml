<?xml version="1.0"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd" >
<!-- All feature files in Chrome headless mode (faster flow/API validation). -->
<suite name="Suite_All_Features_Headless" verbose="1">
    <parameter name="headless" value="true"/>
    <test name="All_Features_Headless">
        <classes>
            <class name="com.qa.bolags.testrunner.AllFeaturesHeadlessRunner"/>
        </classes>
    </test>
</suite>
